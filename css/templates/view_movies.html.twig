{% extends 'base.html.twig' %}

{% block title %}
View Movies
{% endblock %}

{% block content %}

<h1>All Movies</h1>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Genre</th>
        <th>Director</th>
        <th>Release Year</th>
        <th>Rating</th>
        <th>Actions</th>
    </tr>

    {% for movie in movies %}
    <tr>
        <td>{{ movie.id }}</td>
        <td>{{ movie.title }}</td>
        <td>{{ movie.genre }}</td>
        <td>{{ movie.director }}</td>
        <td>{{ movie.release_year }}</td>
        <td>{{ movie.rating }}</td>
        <td>
            <a href="edit_movie.php?id={{ movie.id }}">Edit</a> |
            <a href="delete_movie.php?id={{ movie.id }}">Delete</a>
        </td>
    </tr>
    {% endfor %}

</table>

<br>

<a href="index.php">Back to Home</a>

{% endblock %}