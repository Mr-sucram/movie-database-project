{% extends 'base.html.twig' %}

{% block title %}Search Movies{% endblock %}

{% block content %}

<h1>Search Movies</h1>

<form method="GET">
    <input type="text" name="keyword" placeholder="Search movie title">
    <input type="submit" value="Search">
</form>

{% if movies is defined %}
    <h2>Results</h2>

    {% for movie in movies %}
        <p>
            {{ movie.title }}
            ({{ movie.release_year }})
        </p>
    {% else %}
        <p>No movies found.</p>
    {% endfor %}
{% endif %}

<a href="index.php">Back to Home</a>

{% endblock %}